#!/bin/bash
#
# themed-files-apply - restyle libadwaita apps to match the current Omarchy theme.
#
#   themed-files-apply
#
# Reads the current Omarchy palette from
# ~/.local/state/omarchy/current/theme/colors.toml (via omarchy-theme-color,
# which resolves aliases and derived shades) and writes
# ~/.config/gtk-4.0/gtk.css overriding libadwaita's named colors.
# Visual only: no functionality of any app is touched.

set -euo pipefail

COLORS_FILE="$HOME/.local/state/omarchy/current/theme/colors.toml"
GTK_CSS="$HOME/.config/gtk-4.0/gtk.css"
NAUTILUS_NAME="org.gnome.Nautilus"

color() {
  omarchy-theme-color --file "$COLORS_FILE" "$1" 2>/dev/null || true
}

nautilus_running() {
  gdbus call --session --dest org.freedesktop.DBus \
    --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.NameHasOwner "$NAUTILUS_NAME" 2>/dev/null | grep -q true
}

accent=$(color accent)
background=$(color background)
darker_background=$(color darker_background)
lighter_background=$(color lighter_background)
foreground=$(color foreground)
muted=$(color muted)
selection=$(color selection_background)
selection_fg=$(color selection_foreground)
mode=$(color mode)

# Sane dark fallbacks if the theme file is missing or unreadable.
: "${accent:=#cacccc}"
: "${background:=#101315}"
: "${darker_background:=#0c0f11}"
: "${lighter_background:=$(printf '%s' "$background" | sed 's/.*/#1a2024/')}"
: "${foreground:=#cacccc}"
: "${muted:=#707880}"
: "${selection:=$lighter_background}"
: "${selection_fg:=$foreground}"
: "${mode:=dark}"

is_light() { [[ $mode == "light" ]]; }

# Light mode flips the adw window chrome: light windows need dark text on
# light backgrounds and a darker headerbar than the canvas (adw's own light
# theme darkens headerbar_bg slightly relative to window_bg... actually it
# keeps them equal; we keep them equal too).
if is_light; then
  window_bg=$background
  window_fg=$foreground
  view_bg=$lighter_background
  view_fg=$foreground
  sidebar_bg=$darker_background
  sidebar_fg=$foreground
  dialog_bg=$background
  dialog_fg=$foreground
  popover_bg=$lighter_background
  popover_fg=$foreground
  card_bg=$lighter_background
  card_fg=$foreground
  headerbar_bg=$background
  headerbar_fg=$foreground
  headerbar_backdrop=$background
  secondary_sidebar_bg=$darker_background
  thumbnail_bg=$lighter_background
else
  window_bg=$background
  window_fg=$foreground
  # Match the shell's menu/launcher surfaces: one flat background everywhere,
  # with lighter_background reserved for hover/selection fills.
  view_bg=$background
  view_fg=$foreground
  sidebar_bg=$background
  sidebar_fg=$foreground
  dialog_bg=$background
  dialog_fg=$foreground
  popover_bg=$background
  popover_fg=$foreground
  card_bg=$background
  card_fg=$foreground
  headerbar_bg=$background
  headerbar_fg=$foreground
  headerbar_backdrop=$background
  secondary_sidebar_bg=$background
  thumbnail_bg=$background
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

cat >"$tmp" <<EOF
/* Generated by cheapseatsecon.themed-files (omarchy-themed-files).
 * Restyles libadwaita apps to match the Omarchy theme "$mode" palette.
 * Regenerated on every theme change; hand edits will be overwritten. */

@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $background;

@define-color window_bg_color $window_bg;
@define-color window_fg_color $window_fg;
@define-color view_bg_color $view_bg;
@define-color view_fg_color $view_fg;
@define-color sidebar_bg_color $sidebar_bg;
@define-color sidebar_fg_color $sidebar_fg;
/* Keep the unfocused sidebar identical to focused: libadwaita otherwise
 * swaps in its own gray backdrop color. */
@define-color sidebar_backdrop_color $sidebar_bg;
@define-color secondary_sidebar_backdrop_color $sidebar_bg;
@define-color secondary_sidebar_bg_color $secondary_sidebar_bg;
@define-color dialog_bg_color $dialog_bg;
@define-color dialog_fg_color $dialog_fg;
@define-color popover_bg_color $popover_bg;
@define-color popover_fg_color $popover_fg;
@define-color card_bg_color $card_bg;
@define-color card_fg_color $card_fg;
@define-color thumbnail_bg_color $thumbnail_bg;
@define-color headerbar_bg_color $headerbar_bg;
@define-color headerbar_fg_color $headerbar_fg;
@define-color headerbar_backdrop_color $headerbar_backdrop;
@define-color border_color $muted;

/* Selection: theme selection background (launcher-row equivalent), theme
 * foreground text. */
@define-color theme_selected_bg_color $selection;
@define-color theme_selected_fg_color $selection_fg;

:root {
  --accent-color: $accent;
  --accent-bg-color: $accent;
  --accent-fg-color: $background;

  --window-bg-color: $window_bg;
  --window-fg-color: $window_fg;
  --view-bg-color: $view_bg;
  --view-fg-color: $view_fg;
  --sidebar-bg-color: $sidebar_bg;
  --sidebar-fg-color: $sidebar_fg;
  --sidebar-backdrop-color: $sidebar_bg;
  --secondary-sidebar-backdrop-color: $sidebar_bg;
  --secondary-sidebar-bg-color: $secondary_sidebar_bg;
  --dialog-bg-color: $dialog_bg;
  --dialog-fg-color: $dialog_fg;
  --popover-bg-color: $popover_bg;
  --popover-fg-color: $popover_fg;
  --card-bg-color: $card_bg;
  --card-fg-color: $card_fg;
  --thumbnail-bg-color: $thumbnail_bg;
  --headerbar-bg-color: $headerbar_bg;
  --headerbar-fg-color: $headerbar_fg;
  --headerbar-backdrop-color: $headerbar_backdrop;
  --border-color: $muted;
}

/* GTK text selection inside entries and views uses theme_selected_* on
 * GTK4/libadwaita; scope it so hover/focus rings stay adw-native. */
window {
  color: $window_fg;
}
EOF

mkdir -p "$(dirname "$GTK_CSS")"
# Atomic replace so a concurrent app start never reads a half-written file.
if [[ -f $GTK_CSS ]] && cmp -s "$tmp" "$GTK_CSS"; then
  : # unchanged; skip rewrite
else
  mv "$tmp" "$GTK_CSS"
  chmod 644 "$GTK_CSS"
  if nautilus_running; then
    nautilus --quit >/dev/null 2>&1 || true

    for _ in {1..100}; do
      if ! nautilus_running; then
        break
      fi
      sleep 0.1
    done

    if nautilus_running; then
      printf 'Nautilus did not exit after the graceful quit request; not launching a second instance.\n' >&2
      exit 1
    fi

    omarchy launch nautilus >/dev/null 2>&1 &
    for _ in {1..100}; do
      if nautilus_running; then
        exit 0
      fi
      sleep 0.1
    done

    printf 'Nautilus did not start after the theme update.\n' >&2
    exit 1
  fi
fi
